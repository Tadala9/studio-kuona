---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Picture from '../components/Picture.astro';
import heroImage from '../images/lakeshore-lounge-1.jpg';
import founderImage from '../images/tadala-bowazi.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const services = [
  { title: 'Interior design', text: 'Concept to specification: materials, furniture, lighting and art, chosen to tell one story.' },
  { title: 'Spatial planning', text: 'Layouts that make the most of a room, from compact studios to reworked bathrooms.' },
  { title: 'Heritage & adaptive reuse', text: 'New uses for historic buildings, designed to respect what is already there.' },
  { title: '3D visualisation', text: 'Photoreal renders so you can see the space, and decide, before anything is built.' },
];
---

<Base
  title="Studio Kuona · Interior & spatial design, London"
  description="Studio Kuona is an interior and spatial design studio rooted in African design storytelling, designing calm, contemporary spaces for hospitality, workplaces and homes."
>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <p class="label label--muted">Interior &amp; spatial design · London</p>
    <h1 id="hero-heading" class="hero__heading">Interiors rooted in African design storytelling.</h1>
    <div class="hero__buttons">
      <a class="button button--solid" href="#work">View work</a>
      <a class="button button--outline" href="#contact">Start a project</a>
    </div>
  </section>

  <figure class="hero-image">
    <Picture
      src={heroImage}
      alt="Lounge view towards the console and media wall under the timber roof"
      sizes="100vw"
      eager
      class="hero-image__picture"
    />
    <figcaption class="wrap caption-row label label--muted">
      <span>Lakeshore House · Lake Malawi</span>
      <span>Visualisation</span>
    </figcaption>
  </figure>

  <section class="intro wrap" aria-label="Introduction">
    <p class="statement intro__text">
      Studio Kuona designs spaces that carry a story. We draw on African craft, pattern and vernacular building, and
      translate them into calm, contemporary interiors for hospitality, workplaces and homes.
    </p>
  </section>

  <section id="work" class="work wrap" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading" class="label">Selected work</h2>
      <span class="label" aria-hidden="true">{String(projects.length).padStart(2, '0')}</span>
    </div>
    <ul class="work__grid">
      {projects.map((project) => (
        <li>
          <a class="card" href={`/work/${project.id}`}>
            <Picture
              src={project.data.card.image}
              alt={project.data.card.alt}
              ratio="4 / 3"
              sizes="(min-width: 768px) 50vw, 100vw"
              class="fade-img"
            />
            <h3 class="card__name">{project.data.name}</h3>
            <p class="card__line">{project.data.card.line}</p>
            <p class="label label--muted">{project.data.card.tag}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="services" aria-labelledby="services-heading">
    <div class="wrap">
      <h2 id="services-heading" class="visually-hidden">Services</h2>
      <ol class="services__grid">
        {services.map((service, i) => (
          <li>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="services__title">{service.title}</h3>
            <p>{service.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="studio" class="studio wrap" aria-labelledby="studio-heading">
    <figure class="studio__photo">
      <Picture
        src={founderImage}
        alt="Tadala Bowazi, founder of Studio Kuona"
        ratio="4 / 5"
        sizes="(min-width: 768px) 45vw, 100vw"
      />
      <figcaption class="label label--muted">Tadala Bowazi · Founder</figcaption>
    </figure>
    <div class="studio__text">
      <h2 id="studio-heading" class="label label--muted">The studio</h2>
      <p class="statement">
        Kuona means “to see” in Chichewa. It is also the studio’s promise: design that sees beyond.
      </p>
      <div class="studio__body">
        <p>
          Studio Kuona was founded by Tadala Bowazi, a Malawian-born, British designer who grew up between Malawi,
          South Africa and the UK, and that mix of places shapes how she designs.
        </p>
        <p>
          Trained first in architecture and then in spatial and interior design, she reads a building before she reads
          a room. She studied Spatial and Interior Design at the University of Kent and has designed for clients in the
          UK and Malawi.
        </p>
        <p>
          Her work spans homes, hospitality and commercial spaces, and is drawn to what others have written off: listed
          buildings waiting for a new life, and design histories the textbooks skipped. Every project starts with the
          people who will actually use it, because access can’t be retrofitted.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="wrap">
      <h2 id="contact-heading" class="contact__heading">Have a space with a story to tell?</h2>
      <ul class="contact__links">
        <li><a class="label text-link" href="mailto:hello@studiokuona.com">hello@studiokuona.com</a></li>
        <li><a class="label text-link" href="https://instagram.com/studiokuona">@studiokuona</a></li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" variant="home" />
</Base>

<style>
  /* Hero text */
  .hero {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .hero__heading {
    max-width: 14em;
    margin-top: 20px;
    font-size: 40px;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  @media (min-width: 1024px) {
    .hero { padding-top: 72px; padding-bottom: 64px; }
    .hero__heading { font-size: 60px; line-height: 1.08; }
    .hero__buttons { margin-top: 44px; }
  }

  /* Hero image */
  .hero-image :global(.hero-image__picture) { height: 420px; }
  @media (min-width: 1024px) {
    .hero-image :global(.hero-image__picture) { height: 760px; }
  }
  .caption-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
  }

  /* Intro */
  .intro {
    padding-top: 80px;
    padding-bottom: 96px;
  }
  .intro__text { max-width: 30em; }
  @media (min-width: 1024px) {
    .intro { padding-top: 128px; padding-bottom: 144px; }
  }

  /* Selected work */
  .work { padding-bottom: 96px; scroll-margin-top: 16px; }
  .section-head {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .work__grid {
    display: grid;
    gap: 56px;
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .work__grid { grid-template-columns: 1fr 1fr; gap: 72px 32px; margin-top: 40px; }
  }
  @media (min-width: 1024px) {
    .work { padding-bottom: 144px; }
  }
  .card { display: block; }
  .card__name {
    margin-top: 20px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .card__line { margin: 4px 0 10px; }

  /* Services */
  .services {
    background: var(--sand);
    padding: 72px 0;
  }
  .services__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 20px;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .services { padding: 112px 0; }
    .services__grid { grid-template-columns: repeat(4, 1fr); gap: 40px; }
  }
  .services__grid li {
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .services__grid p { font-size: 16px; }
  .services__title {
    margin: 12px 0 10px;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }

  /* The studio */
  .studio {
    display: grid;
    gap: 40px;
    align-items: start;
    padding-top: 96px;
    padding-bottom: 96px;
    scroll-margin-top: 16px;
  }
  .studio__photo figcaption { margin-top: 12px; }
  .studio__text .statement { margin-top: 16px; }
  .studio__body { margin-top: 32px; max-width: 36em; }
  .studio__body p + p { margin-top: 1.1em; }
  @media (min-width: 768px) {
    .studio { grid-template-columns: 5fr 6fr; gap: 64px; }
  }
  @media (min-width: 1024px) {
    .studio { gap: 96px; padding-top: 144px; padding-bottom: 144px; }
  }

  /* Contact */
  .contact {
    background: var(--near-black);
    color: var(--off-white);
    padding: 88px 0;
  }
  .contact__heading {
    max-width: 14em;
    font-size: 34px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }
  .contact__links a {
    display: inline-block;
    padding: 12px 0 2px;
    font-size: 13px;
  }
  @media (min-width: 1024px) {
    .contact { padding: 144px 0; }
    .contact__heading { font-size: 52px; }
  }
</style>
