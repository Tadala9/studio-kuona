---
// One image with an optional corner tag (VISUALISATION, BEFORE or AFTER).
// Astro turns the source photo into WebP at several sizes and lazy-loads it unless told otherwise.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  tag?: 'VISUALISATION' | 'BEFORE' | 'AFTER';
  sizes: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
  style?: string;
}

const { src, alt, tag, sizes, ratio, eager = false, class: className, style } = Astro.props;
const widths = [480, 800, 1200, 1600, 2400].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 2400) widths.push(src.width);
---

<div class:list={['picture', className]} style={[ratio && `aspect-ratio: ${ratio}`, style].filter(Boolean).join('; ') || undefined}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  {tag && <span class:list={['tag', 'label', { 'tag--dark': tag === 'AFTER' }]}>{tag}</span>}
</div>

<style>
  .picture {
    position: relative;
    overflow: hidden;
    background: var(--sand);
  }
  .picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    font-size: 11px;
    background: var(--off-white);
    color: var(--near-black);
  }
  .tag--dark {
    background: var(--near-black);
    color: var(--off-white);
  }
  @media (min-width: 768px) {
    .tag { top: 16px; left: 16px; }
  }
</style>
